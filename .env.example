# Application Settings
APP_NAME="Alumni Tracking System"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
POSTGRES_USER=alumni_user
POSTGRES_PASSWORD=alumni_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=alumni_db

# SQLAlchemy Connection URL (Used by ORM)
DATABASE_URL=postgresql://alumni_user:alumni_password@localhost:5432/alumni_db
