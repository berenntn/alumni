# ==============================================================================
# Environment Configuration Template (example.env)
# 
# Duplicate this file as '.env' and populate with your local configuration.
# Never commit '.env' containing real secrets to version control.
# ==============================================================================

# Application Settings
APP_NAME="Alumni Tracking System"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database Configuration
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_database_name

# Optional direct connection URL override (if unset, constructed from POSTGRES_* settings)
# DATABASE_URL=postgresql://your_postgres_user:your_secure_password_here@localhost:5432/your_database_name
